{
  "name": "@oa-lab/api",
  "version": "0.1.0",
  "private": true,
  "prisma": { "schema": "../../prisma/schema.prisma" },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "prisma generate && prisma migrate deploy && tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@oa-lab/execution-engine": "workspace:*",
    "@oa-lab/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "diff": "^8.0.2",
    "dockerode": "^4.0.7",
    "dotenv": "^16.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.41",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "prisma": "6.19.3",
    "tsc-watch": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
