# API
API_PORT=4000
# Where per-session workspaces are created (absolute or relative to repo root)
OA_DATA_DIR=./data
# docker (default, sandboxed) | local (UNSAFE: runs code directly on host, dev only)
OA_EXECUTION_DRIVER=docker
# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Network mode for the one-time dependency preparation step (default: bridge). Use "host" behind a local proxy.
# OA_DOCKER_PREPARE_NETWORK=bridge
# Stop an idle sandbox after N minutes (it restarts automatically when used again; files are kept). 0 = never.
OA_IDLE_STOP_MINUTES=10
# Delete finished attempts' files after N days (scores, test results and diffs stay). 0 = keep forever.
OA_RETENTION_DAYS=7
