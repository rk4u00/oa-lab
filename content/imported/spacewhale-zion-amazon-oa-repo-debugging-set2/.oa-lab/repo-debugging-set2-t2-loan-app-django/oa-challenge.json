{
  "id": "repo-debugging-set2-t2-loan-app-django",
  "title": "Task 2 \u2014 Loan Application (Django)",
  "company": "amazon",
  "category": "repository-debugging",
  "difficulty": "medium",
  "durationMinutes": 60,
  "description": "Imported Django practice repository (t2-loan-app/django). Read the task, make the failing tests pass without editing them.",
  "taskFile": "../../t2-loan-app/django/README.md",
  "starterDir": "../../t2-loan-app/django",
  "runtime": {
    "language": "python",
    "framework": "django",
    "image": "oa-lab-python:latest"
  },
  "workspace": {
    "root": "/workspace"
  },
  "execution": {
    "setup": "pip install -q --disable-pip-version-check --target .oa/pydeps -r requirements.txt",
    "test": "mkdir -p .oa && python -m pytest -q -p no:cacheprovider --ds=config.settings -o \"python_files=tests.py test_*.py *_tests.py\" --junitxml=.oa/results.xml",
    "targetTemplate": "{test} {target}",
    "resultFormat": "junit",
    "resultPath": ".oa/results.xml",
    "timeoutSeconds": 180,
    "env": {
      "PYTHONPATH": "/workspace/.oa/pydeps",
      "PYTHONDONTWRITEBYTECODE": "1"
    }
  },
  "resources": {
    "memoryMb": 1024,
    "cpus": 1,
    "pids": 512,
    "network": false
  },
  "scoring": {
    "type": "test-pass-rate",
    "maxScore": 100
  },
  "features": {
    "terminal": true,
    "editor": true,
    "aiCoach": true,
    "gitDiff": true
  },
  "readOnly": [
    "tests/",
    "pytest.ini"
  ],
  "provenance": {
    "source": "third-party",
    "url": "https://github.com/spacewhale-zion/amazon-oa-repo-debugging-set2",
    "license": "No license file in upstream repository \u2014 included with attribution for practice use"
  }
}