{
  "id": "amazon-debugging-question-sample-helpdesk-express",
  "title": "Worked example \u00b7 HelpDesk (Django, Spring Boot and Node.js)",
  "company": "amazon",
  "category": "repository-debugging",
  "difficulty": "medium",
  "durationMinutes": 60,
  "description": "Imported Node.js practice repository (sample-helpdesk/express). Read the task, make the failing tests pass without editing them.",
  "taskFile": "../../sample-helpdesk/README.md",
  "coachPromptFile": "../../AI_COACH_PROMPT.md",
  "starterDir": "../../sample-helpdesk/express",
  "runtime": {
    "language": "javascript",
    "framework": "express",
    "image": "oa-lab-node:latest"
  },
  "workspace": {
    "root": "/workspace"
  },
  "execution": {
    "setup": "npm install --no-audit --no-fund --loglevel=error",
    "test": "mkdir -p .oa && npx --no-install jest --runInBand --ci --json --outputFile=.oa/results.json",
    "targetTemplate": "{test} {target}",
    "resultFormat": "jest-json",
    "resultPath": ".oa/results.json",
    "timeoutSeconds": 180,
    "env": {
      "CI": "true"
    }
  },
  "resources": {
    "memoryMb": 1024,
    "cpus": 1,
    "pids": 512,
    "network": false
  },
  "scoring": {
    "type": "test-pass-rate",
    "maxScore": 100
  },
  "features": {
    "terminal": true,
    "editor": true,
    "aiCoach": true,
    "gitDiff": true
  },
  "readOnly": [
    "tests/"
  ],
  "provenance": {
    "source": "third-party",
    "url": "https://github.com/govindchandak/Amazon-debugging-question",
